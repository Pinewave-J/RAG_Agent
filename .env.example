# ============================================================
# 知识问答 Agent —— 环境变量样例
# 使用方法：复制本文件为 .env，然后按注释填写。
# Windows:  copy .env.example .env
# macOS/Linux: cp .env.example .env
# ============================================================

# ---------- 服务 ----------
# 监听端口
PORT=8899
# 监听地址。本机自用填 127.0.0.1；容器/服务器对外填 0.0.0.0
HOST=0.0.0.0

# ---------- 大模型（必填） ----------
# 对话模型。DeepSeek 官方端点
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-在这里填入你的DeepSeek密钥
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2
# 输出预算。推理模型（如 deepseek-flash）的思维链与正文**共享**这个预算，
# 且思维链实测稳定占 3000~3400 字，故给到 8192；设 1600 会导致正文一个字都出不来。
LLM_MAX_TOKENS=8192
# 是否关闭模型的"思考"（思维链）：auto | off | on
#   auto —— 模型名含 reasoner/reasoning/r1 时自动关闭（默认）
#   off  —— 强制关闭。deepseek-flash 这类靠名字识别不出来，改用这个
#   on   —— 强制保留思考
# RAG 场景资料已由检索层筛好，关思考可省预算、降延迟，且不损害防编造能力。
LLM_DISABLE_THINKING=auto
LLM_TIMEOUT_MS=90000

# ---------- 向量检索（选填） ----------
# DeepSeek 官方暂不提供 Embedding 接口，因此默认留空 => 自动降级为纯本地 BM25 关键词检索。
# 若你另有 OpenAI 兼容的 Embedding 服务，取消下面三行注释即可开启混合检索，召回率会明显提升。
# 例（阿里云百炼）： EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 例（智谱 AI）   ： EMBED_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 例（OpenAI）    ： EMBED_BASE_URL=https://api.openai.com/v1
# EMBED_BASE_URL=
# EMBED_API_KEY=
# EMBED_MODEL=text-embedding-v3
# 单次向量化请求的最大条数（不同厂商上限不同，通义为 10，OpenAI 为 2048）
EMBED_BATCH_SIZE=10

# ---------- 知识库管理口令（强烈建议设置） ----------
# 非空时，知识库的「上传 / 删除 / 重建索引」接口需要携带该口令。
# 问答接口不受影响，普通访客可直接提问。
ADMIN_TOKEN=

# ---------- 检索参数（一般无需改动） ----------
# 送进模型的资料片段数量
RETRIEVAL_TOP_K=5
# 候选池大小（先粗排多少条再融合）
RETRIEVAL_CANDIDATES=20
# 兜底阈值：查询词在最佳片段中的加权覆盖率低于该值时，直接回复"知识库未覆盖"，不调用大模型
# 调高 -> 更容易触发兜底（更保守）；调低 -> 更多问题会交给模型判断
RETRIEVAL_MIN_COVERAGE=0.34
# 片段长度（字符）与重叠长度
CHUNK_SIZE=620
CHUNK_OVERLAP=120
# 单文件上传体积上限（MB）
MAX_UPLOAD_MB=30

# ---------- 目录 ----------
KB_DIR=knowledge
DATA_DIR=data
